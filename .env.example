# Kopiera till .env. API-nyckel behövs INTE för DEMO.
JARVIS_MODE=DEMO
JARVIS_DATA_DIR=data
JARVIS_ORIGIN=http://127.0.0.1:8000
JARVIS_SECURE_COOKIE=false
OPENAI_API_KEY=
JARVIS_PAID_ENABLED=false
# Välj en modell som ditt API-konto har tillgång till. Inget modellnamn antas.
JARVIS_MODEL=
# Valfria överstyrningar per stabilt agent-ID, JSON:
JARVIS_AGENT_MODELS={}
# Priser anges per EN MILJON token i USD. Inga priser antas.
JARVIS_INPUT_USD=
JARVIS_OUTPUT_USD=
JARVIS_USD_SEK=
JARVIS_PRICE_VERSION=
# Samma prisprofil måste gälla samtliga valda modeller, annars separata installationer.
JARVIS_PRICED_MODEL=
JARVIS_RESEARCH_ENABLED=false

